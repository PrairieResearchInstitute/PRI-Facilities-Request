# Written by facilities/install.php, which refuses to run once it exists.
# Committed, it makes a fresh clone believe it is already installed, and it
# carries a live app_key: install.php generates one with random_bytes(32).
# The installer recreates it, so it is output, not source.
config.php
config.php.before-split

